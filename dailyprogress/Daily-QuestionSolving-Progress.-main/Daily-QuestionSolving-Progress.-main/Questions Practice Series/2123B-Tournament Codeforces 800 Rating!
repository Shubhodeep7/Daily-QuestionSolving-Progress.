#include<bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, j, k;
        cin >> n >> j >> k;
        
        vector<int> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        
        int playerStrength = a[j - 1];
        int stronger = 0;
        for (int i = 0; i < n; i++) {
            if (a[i] > playerStrength) {
                stronger++;
            }
        }
        if (stronger < k) {
            cout << "YES" << endl;
        } else {
            cout << "NO" << endl;
        }
    }
    return 0;
}
