#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while (t--) {
        long long a, b, c;
        cin >> a >> b >> c;
        long long sa = (c + 1) / 2;
        long long sk = c / 2;
        long long ta = a + sa;
        long long tk = b + sk;
        if (ta > tk) {
            cout << "First\n";
        } else {
            cout << "Second\n";
        }
    }
    return 0;
}
