#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m;
        cin >> n >> m;
        int total = 0;
        int count = 0;
        for (int i = 0; i < n; i++) {
            string s;
            cin >> s;
            if (total + (int)s.length() <= m) {
                total += s.length();
                count++;
            }
        }
        cout << count << "\n";
    }
    return 0;
}



