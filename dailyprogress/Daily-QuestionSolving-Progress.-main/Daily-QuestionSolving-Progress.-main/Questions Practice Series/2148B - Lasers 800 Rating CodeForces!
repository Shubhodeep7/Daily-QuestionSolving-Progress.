#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while (t--) {
        long long n, m, x, y;
        cin >> n >> m >> x >> y;
        for (int i = 0; i < n; i++) cin >> x;
        for (int i = 0; i < m; i++) cin >> y;
        cout << n + m << "\n";
    }
    return 0;
}
