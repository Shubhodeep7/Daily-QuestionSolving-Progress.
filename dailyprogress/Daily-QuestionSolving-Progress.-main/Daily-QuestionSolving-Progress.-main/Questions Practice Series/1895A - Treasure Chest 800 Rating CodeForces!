#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while(t--) {
        int x, y, k;
        cin >> x >> y >> k;
        int direct = abs(y) + abs(x - y);
        int carry = abs(x) + abs(x - y);
        if(k >= abs(x - y))
            cout << min(direct, carry) << endl;
        else
            cout << direct << endl;
    }
    return 0;
}
