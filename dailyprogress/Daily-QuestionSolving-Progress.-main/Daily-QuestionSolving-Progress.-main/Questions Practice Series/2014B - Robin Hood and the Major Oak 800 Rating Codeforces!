#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while (t--) {
        long long n, k;
        cin >> n >> k;
        long long L = max(1LL, n - k + 1);
        long long R = n;
        long long countYears = R - L + 1;              
        long long sum = (L + R) * countYears / 2;     
        if (sum % 2 == 0)
            cout << "YES\n";
        else
            cout << "NO\n";
    }
    return 0;
}
