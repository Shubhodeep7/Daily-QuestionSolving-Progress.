#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; i++)
            cin >> a[i];
        bool ok = true;
        if (a[0] != 1 || a[n - 1] != n)
            ok = false;
        cout << (ok ? "YES\n" : "NO\n");
    }
    return 0;
}
